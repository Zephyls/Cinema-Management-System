<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="cinemaPU">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>cinema.model.Genre</class>
        <class>cinema.model.Movie</class>
        <class>cinema.model.AdultMovie</class>
        <class>cinema.model.ChildrenMovie</class>
        <class>cinema.model.Room</class>
        <class>cinema.model.Room2D</class>
        <class>cinema.model.IMAX</class>
        <class>cinema.model.Dolby</class>
        <class>cinema.model.Screening</class>
        <class>cinema.model.Ticket</class>
        <class>cinema.model.Purchase</class>
        <class>cinema.model.Coupon</class>
        <class>cinema.model.Person</class>
        <class>cinema.model.Customer</class>
        <class>cinema.model.Employee</class>
        <class>cinema.model.Cashier</class>
        <class>cinema.model.ScreeningEmployee</class>
        <class>cinema.model.Fulltime</class>
        <class>cinema.model.Parttime</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:file:./cinema-db-role-gui;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
